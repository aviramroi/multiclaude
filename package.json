{
  "name": "multiclaude",
  "version": "0.1.0",
  "description": "git-style push/pull + live multiplayer for Claude Code (and later Codex) sessions",
  "type": "module",
  "bin": {
    "mc": "./bin/mc"
  },
  "scripts": {
    "server": "bun run src/server/index.ts",
    "cli": "bun run src/cli/index.ts",
    "build": "bun build --compile --minify src/cli/index.ts --outfile dist/mc",
    "test": "bun test",
    "build:vercel": "bun build src/vercel.ts --target=node --format=esm --outfile=api/index.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/nodemailer": "^8.0.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "nodemailer": "^10.0.10"
  }
}
